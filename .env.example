# ==============================================================================
# 🏁 MUNTRUME MOTORSPORT - ENVIRONMENT VARIABLES CONFIGURATION
# Configure these in Cloudflare Dashboard (Pages -> Settings -> Environment Variables)
# OR locally in a .dev.vars file (never commit real keys to Git).
# ==============================================================================

# 1. Resend API Key for sending emails to info@muntru.me (REQUIRED for contact form)
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# 2. Sender email address (Optional, default is onboarding@resend.dev until muntru.me is verified in Resend)
RESEND_FROM_EMAIL=Muntrume Motorsport <onboarding@resend.dev>

# 3. Backend Cloudflare Worker URL for server-to-server AI/telemetry proxy (Optional)
# This stays 100% private on the server; the browser never sees this URL.
BACKEND_WORKER_URL=https://muntrume.atrumin16.workers.dev

# 4. Optional secret token for backend worker authentication
WORKER_AUTH_SECRET=your_custom_shared_secret_token
